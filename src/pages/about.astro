---
import { getCollection } from "astro:content";
import BasicLayout from "../layouts/BasicLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { readFile } from "fs/promises";
import { existsSync } from "fs";
import path from "path";

// Load about page data from aboutpage-local.json
let aboutData = {
  about: "",
  photo: "",
  selectedClients: [],
};

const aboutPageJson = path.join(
  process.cwd(),
  "src",
  "data",
  "aboutpage-local.json"
);
if (existsSync(aboutPageJson)) {
  try {
    const raw = await readFile(aboutPageJson, "utf8");
    const data = JSON.parse(raw);
    if (data && typeof data === "object") {
      aboutData = data;
    }
    console.log("Using aboutpage-local.json data:", aboutData);
  } catch (err) {
    console.error("Failed to read aboutpage-local.json:", err.message);
  }
} else {
  console.warn(
    "aboutpage-local.json not found. Run 'npm run build-assets' to fetch data."
  );
}

// Split about text into paragraphs
const aboutParagraphs = aboutData.about
  ? aboutData.about.split("\n\n").filter((p) => p.trim())
  : [];
---

<BasicLayout title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <main>
    <h1 class="big-title">About Iley</h1>
    <div class="about-container grid md:grid-cols-2 gap-8 p-4 pb-12 border-t">
      {
        aboutData.photo ? (
          <img src={aboutData.photo} alt="Iley Cao" class="profile-image" />
        ) : (
          <img src="img/profile.jpg" alt="Iley Cao" class="profile-image" />
        )
      }
      <div class="bio">
        <div class="flex flex-col mb-8 font-serif">
          <a href="mailto:iley.cao@gmail.com">iley.cao@gmail.com</a>
          <a href="https://www.linkedin.com/in/iley-cao/">Linkedin</a>
          <a href="https://www.instagram.com/iley.c/">Instagram</a>
        </div>

        {
          aboutParagraphs.map((paragraph, index) => (
            <p class="short-description" key={index}>
              {paragraph}
            </p>
          ))
        }

        <div class="mt-20">
          <h2>Selected Clients</h2>
          <ul class="opacity-40">
            {
              aboutData.selectedClients.map((client, index) => (
                <li key={index}>{client}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </main>
</BasicLayout>
